# Required: shared secret for every endpoint except /health.
JARVIS_TOKEN=change-me-to-a-long-random-string

# Read-only API tokens. Each source is skipped (and reported) if its token is missing.
RAILWAY_API_TOKEN=
NETLIFY_TOKEN=
GITHUB_TOKEN=
# GitHub owner (user or org) to audit, e.g. chiinsurancebrokers
GITHUB_OWNER=chiinsurancebrokers

# Optional tuning
DEFAULT_LANG=en          # en | el
STALE_DAYS=90            # Netlify deploy older than this is flagged as stale
DORMANT_DAYS=180         # GitHub repo untouched this long is flagged as dormant
AUDIT_INTERVAL_HOURS=6

# --- Email agent (v0.2) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Postgres (Railway provides this). Without it, history is kept in memory only.
DATABASE_URL=
RULES_PATH=rules/jarvis-rules.md
POLL_MINUTES=5
# Google OAuth, scopes: gmail.readonly and gmail.compose (drafts only)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Autonomy: leave off. Shadow mode only records what it would have done.
AUTONOMY_ENABLED=false
AUTONOMY_CATEGORIES=
AUTONOMY_MIN_DECISIONS=20
AUTONOMY_MIN_UNCHANGED_RATE=0.9
AUTONOMY_MIN_CONFIDENCE=0.8

# Extra public URLs to check for uptime (comma separated). Netlify sites are added automatically.
PROBE_URLS=
